import java.io.*;
import java.util.*;


public class Main {

    private static int[] bfs(int u, int n, List<Integer>[] adj) {
        Queue<Integer> q = new ArrayDeque<>();
        q.offer(u);
        int[] dist = new int[n];
        Arrays.fill(dist, -1);
        dist[u] = 0;

        int maxDist = 0;
        int farthestNode = 0;
        while (!q.isEmpty()) {
            int curr = q.poll();

            if(dist[curr] > maxDist) {
                maxDist = dist[curr];
                farthestNode = curr;
            }

            for (int i : adj[curr]) {
                if (dist[i] == -1) {
                    dist[i] = dist[curr] + 1;
                    q.offer(i);
                }
            }
        }
        return new int[]{farthestNode, maxDist};
    }

    public static void solve(FastScanner fs, PrintWriter out) {
        int n = fs.nextInt();
        if (n == 1) {
            out.println(0);
            return;
        }

        List<Integer>[] adj = new ArrayList[n];
        for (int i = 0; i < n; i++) adj[i] = new ArrayList<>();

        for (int i = 0; i < n - 1; i++) {
            int u = fs.nextInt() - 1;
            int v = fs.nextInt() - 1;
            adj[u].add(v);
            adj[v].add(u);
        }

//        dfs from any node to its farthest node
        int[] f = bfs(0, n, adj);
        int[] ans = bfs(f[0], n, adj);
        out.println(ans[1]);
        return;
    }

    public static void main(String[] args) {
        FastScanner fs = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);
        int t = 1;
        while (t-- > 0) {
            solve(fs, out);
        }

        out.flush();
        out.close();
    }

    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0)
                    return -1;
            }
            return buffer[ptr++];
        }

        String next() {
            StringBuilder sb = new StringBuilder();
            try {
                int c;

                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return null;
                }

                do {
                    sb.append((char) c);
                    c = read();
                } while (c > ' ');

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }

        int nextInt() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                int val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        long nextLong() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                long val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        double nextDouble() {
            return Double.parseDouble(next());
        }

        char nextChar() {
            return next().charAt(0);
        }

        String nextLine() {
            StringBuilder sb = new StringBuilder();

            try {
                int c = read();

                // skip '\n' and '\r'
                while (c == '\n' || c == '\r') {
                    c = read();
                }

                while (c != '\n' && c != '\r' && c != -1) {
                    sb.append((char) c);
                    c = read();
                }

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }
    }
}
