import java.io.*;
import java.util.*;


public class Main {
    static final long INF = Long.MAX_VALUE/2;

    static class Pair {
        int city;
        long distance;
        public Pair(int city, long distance) {
            this.city = city;
            this.distance = distance;
        }
    }
    public static void solve(FastScanner fs, PrintWriter out) {
        int n = fs.nextInt();
        int m = fs.nextInt();
        int q = fs.nextInt();

        long[][] distances = new long[n][n];

        for(int i = 0; i < n; i++) {
            for(int j = 0; j < n; j++) {
                if(i == j) continue;
                distances[i][j] = INF;
            }
        }

        for(int i = 0; i < m; i++) {
            int u = fs.nextInt() - 1;
            int v = fs.nextInt() - 1;
            long d = fs.nextLong();
            if (d < distances[u][v]) {
                distances[u][v] = d;
                distances[v][u] = d;
            }
        }

        // Optimized Floyd-Warshall Triple Loop
        for (int k = 0; k < n; k++) {
            long[] distK = distances[k];
            for (int i = 0; i < n; i++) {
                long distIK = distances[i][k];
                if (distIK == INF) continue; // Skip unreachable middle nodes early!

                long[] distI = distances[i];
                for (int j = 0; j < n; j++) {
                    long newDist = distIK + distK[j];
                    if (newDist < distI[j]) {
                        distI[j] = newDist;
                    }
                }
            }
        }

        // Processing queries
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < q; i++) {
            int u = fs.nextInt() - 1;
            int v = fs.nextInt() - 1;
            long res = distances[u][v];
            if (res == INF) {
                sb.append("-1\n");
            } else {
                sb.append(res).append("\n");
            }
        }
        out.print(sb.toString());
        return;
    }

    public static void main(String[] args) {
        FastScanner fs = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);
        int t = 1;
        while (t-- > 0) {
            solve(fs, out);
        }

        out.flush();
        out.close();
    }

    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0)
                    return -1;
            }
            return buffer[ptr++];
        }

        String next() {
            StringBuilder sb = new StringBuilder();
            try {
                int c;

                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return null;
                }

                do {
                    sb.append((char) c);
                    c = read();
                } while (c > ' ');

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }

        int nextInt() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                int val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        long nextLong() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                long val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        double nextDouble() {
            return Double.parseDouble(next());
        }

        char nextChar() {
            return next().charAt(0);
        }

        String nextLine() {
            StringBuilder sb = new StringBuilder();

            try {
                int c = read();

                // skip '\n' and '\r'
                while (c == '\n' || c == '\r') {
                    c = read();
                }

                while (c != '\n' && c != '\r' && c != -1) {
                    sb.append((char) c);
                    c = read();
                }

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }
    }
}
