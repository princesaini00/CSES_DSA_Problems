import java.io.*;
import java.util.*;


public class Main {
    static List<List<Integer>> graph;
    static List<List<Integer>> revGraph;
    static boolean[] visited;
    static List<Integer> traversed;
    static int[] component;
    static int componentNumber = 0;
    static long[] componentCoins;

    private static void dfs(int node, List<List<Integer>> g) {
        visited[node] = true;
        for (int ngh : g.get(node)) {
            if (!visited[ngh]) {
                dfs(ngh, g);
            }
        }
        traversed.add(node);
    }
    private static void markStrongComponent(int node, List<List<Integer>> g, int[] coins) {
        visited[node] = true;
        component[node] = componentNumber;
        componentCoins[componentNumber] += coins[node];
        for (int ngh : g.get(node)) {
            if (!visited[ngh]) {
                markStrongComponent(ngh, g, coins);
            }
        }
    }

    public static void solve(FastScanner fs, PrintWriter out) {
        int n = fs.nextInt();
        int m = fs.nextInt();

        int[] coins = new int[n];
        for (int i = 0; i < n; i++) {
            coins[i] = fs.nextInt();
        }

        graph = new ArrayList<>();
        revGraph = new ArrayList<>();
        for(int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
            revGraph.add(new ArrayList<>());
        }

        for(int i = 0; i < m; i++) {
            int u = fs.nextInt() - 1;
            int v = fs.nextInt() - 1;
            graph.get(u).add(v);
            revGraph.get(v).add(u);
        }

        traversed = new ArrayList<>();
        visited = new boolean[n];
        for(int i = 0; i < n; i++) {
            if(!visited[i]) {
                dfs(i, graph);
            }
        }

        component = new int[n];
        visited = new boolean[n];
        componentNumber = 0;
        componentCoins = new long[n + 1];
        for(int i = traversed.size()-1; i >= 0; i--) {
            int node = traversed.get(i);
            if(!visited[node]) {
                componentNumber++;
                markStrongComponent(node, revGraph, coins);
            }
        }

//        now make a condensed DAG with scc's
        List<List<Integer>> dag = new ArrayList<>();
        for(int i = 0; i <= componentNumber; i++) {
            dag.add(new ArrayList<>());
        }
        for(int u = 0; u < n; u++) {
            for(int v : graph.get(u)) {
                if(component[u] != component[v]) {
                    dag.get(component[u]).add(component[v]);
                }
            }
        }

//        Apply topo DP logic now
        long[] dp = new long[componentNumber+1];
        long maxCoins = 0;
        for(int i = componentNumber; i >= 1; i--) {
            long maxNextSum = 0;
            for(int next : dag.get(i)) {
                maxNextSum = Math.max(maxNextSum, dp[next]);
            }
            dp[i] = componentCoins[i] + maxNextSum;
            maxCoins = Math.max(maxCoins, dp[i]);
        }

        out.println(maxCoins);
        return;
    }

    public static void main(String[] args) {
        FastScanner fs = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);
        int t = 1;
        while (t-- > 0) {
            solve(fs, out);
        }

        out.flush();
        out.close();
    }

    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0)
                    return -1;
            }
            return buffer[ptr++];
        }

        String next() {
            StringBuilder sb = new StringBuilder();
            try {
                int c;

                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return null;
                }

                do {
                    sb.append((char) c);
                    c = read();
                } while (c > ' ');

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }

        int nextInt() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                int val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        long nextLong() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                long val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        double nextDouble() {
            return Double.parseDouble(next());
        }

        char nextChar() {
            return next().charAt(0);
        }

        String nextLine() {
            StringBuilder sb = new StringBuilder();

            try {
                int c = read();

                // skip '\n' and '\r'
                while (c == '\n' || c == '\r') {
                    c = read();
                }

                while (c != '\n' && c != '\r' && c != -1) {
                    sb.append((char) c);
                    c = read();
                }

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }
    }
}
