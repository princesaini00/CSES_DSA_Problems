import java.io.*;
import java.util.*;


public class Main {
    static List<List<Edge>> graph;
    static int[] edgeIndex;
    static boolean[] usedEdge;
    static List<Integer> circuit;

    private static class Edge {
        int node;
        int edgeNum;
        public Edge(int node, int edgeNum) {
            this.node = node;
            this.edgeNum = edgeNum;
        }
    }
    public static void solve(FastScanner fs, PrintWriter out) {
        int n = fs.nextInt();
        int m = fs.nextInt();

       graph = new ArrayList<>();
       for(int i = 0; i < n; i++) {
           graph.add(new ArrayList<>());
       }

       int[] degree = new int[n];
       for(int i = 0; i < m; i++) {
           int a = fs.nextInt() - 1;
           int b = fs.nextInt() - 1;
           graph.get(a).add(new Edge(b, i));
           graph.get(b).add(new Edge(a, i));
           degree[a]++;
           degree[b]++;
       }

//      First check if all have even degree, then only Eulerian circuit possible
        for(int i = 0; i < n; i++) {
            if(degree[i] % 2 != 0) {
                out.println("IMPOSSIBLE");
                return;
            }
        }

//       Now using Hierholzer's algorithm for eulerian circuits
        edgeIndex = new int[n];
        usedEdge = new boolean[m];
        circuit = new ArrayList<>();

        Deque<Integer> stack = new ArrayDeque<>();
        stack.push(0);

        while(!stack.isEmpty()) {
            int u = stack.peek();

            while(edgeIndex[u] < graph.get(u).size() && usedEdge[graph.get(u).get(edgeIndex[u]).edgeNum]) {
                edgeIndex[u]++;
            }

            if(edgeIndex[u] < graph.get(u).size()) {
                Edge e = graph.get(u).get(edgeIndex[u]);
                usedEdge[e.edgeNum] = true;
                stack.push(e.node);
                edgeIndex[u]++;
            } else {
                circuit.add(stack.pop());
            }
        }

        if(circuit.size() != m+1) {
            out.println("IMPOSSIBLE");
            return;
        }

       StringBuilder sb = new StringBuilder();
       for(int i = circuit.size() - 1; i >= 0; i--) {
           sb.append(circuit.get(i)+1).append(i == 0 ? "" : " ");
       }
       out.println(sb.toString());
        return;
    }

    public static void main(String[] args) {
        FastScanner fs = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);
        int t = 1;
        while (t-- > 0) {
            solve(fs, out);
        }

        out.flush();
        out.close();
    }

    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0)
                    return -1;
            }
            return buffer[ptr++];
        }

        String next() {
            StringBuilder sb = new StringBuilder();
            try {
                int c;

                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return null;
                }

                do {
                    sb.append((char) c);
                    c = read();
                } while (c > ' ');

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }

        int nextInt() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                int val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        long nextLong() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                long val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        double nextDouble() {
            return Double.parseDouble(next());
        }

        char nextChar() {
            return next().charAt(0);
        }

        String nextLine() {
            StringBuilder sb = new StringBuilder();

            try {
                int c = read();

                // skip '\n' and '\r'
                while (c == '\n' || c == '\r') {
                    c = read();
                }

                while (c != '\n' && c != '\r' && c != -1) {
                    sb.append((char) c);
                    c = read();
                }

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }
    }
}
