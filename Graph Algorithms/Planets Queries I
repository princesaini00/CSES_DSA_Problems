import java.io.*;
import java.util.*;


public class Main {
    static final int LOG = 30; // 2^30 > 10^9
    public static void solve(FastScanner fs, PrintWriter out) {
        int n = fs.nextInt();
        int q = fs.nextInt();

//        successor paths, making ancestor tables
        int[][] up = new int[n][LOG];
        for(int[] row : up) {
            Arrays.fill(row, -1);
        }

//        Fill first column first, for 2^0=1 jump from each node will lead to:
        for(int i = 0; i < n; i++) {
            up[i][0] = fs.nextInt()-1;
        }

//        Fill remaining table
        for(int c = 1; c < LOG; c++) {
            for(int r = 0; r < n; r++) {
                if(up[r][c-1] != -1)
                    up[r][c] = up[up[r][c - 1]][c - 1];
            }
        }

//        Now take all the queries
        StringBuilder sb = new StringBuilder();
        for(int i = 0; i < q; i++) {
            int x = fs.nextInt()-1;
            int k = fs.nextInt();

            for(int j = 0; j < LOG; j++) {
                if((k >> j & 1) == 1) {
                    x = up[x][j];
                }
            }
            sb.append(x+1).append(i == q-1 ? "" : "\n");
        }
        out.println(sb.toString());
        return;
    }

    public static void main(String[] args) {
        FastScanner fs = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);
        int t = 1;
        while (t-- > 0) {
            solve(fs, out);
        }

        out.flush();
        out.close();
    }

    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0)
                    return -1;
            }
            return buffer[ptr++];
        }

        String next() {
            StringBuilder sb = new StringBuilder();
            try {
                int c;

                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return null;
                }

                do {
                    sb.append((char) c);
                    c = read();
                } while (c > ' ');

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }

        int nextInt() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                int val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        long nextLong() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                long val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        double nextDouble() {
            return Double.parseDouble(next());
        }

        char nextChar() {
            return next().charAt(0);
        }

        String nextLine() {
            StringBuilder sb = new StringBuilder();

            try {
                int c = read();

                // skip '\n' and '\r'
                while (c == '\n' || c == '\r') {
                    c = read();
                }

                while (c != '\n' && c != '\r' && c != -1) {
                    sb.append((char) c);
                    c = read();
                }

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }
    }
}
