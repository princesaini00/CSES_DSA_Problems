import java.io.*;
import java.util.*;
 
 
public class Main {
    static class DSU {
        int[] parent;
        int[] size;
        int noOfComponents;
        int maxComponentSize;
 
        public DSU(int n) {
            parent = new int[n];
            size = new int[n];
            for (int i = 0; i < n; i++) {
                parent[i] = i;
                size[i] = 1;
            }
            noOfComponents = n;
            maxComponentSize = 1;
        }
        public int find(int i) {
            if (parent[i] == i) return i;
            return parent[i] = find(parent[i]); // Path compression
        }
        public void union(int i, int j) {
            int rootI = find(i);
            int rootJ = find(j);
            if(rootI == rootJ) return;
            if (size[rootI] > size[rootJ]) {
                parent[rootJ] = rootI;
                size[rootI] += size[rootJ];
                noOfComponents--;
                if(size[rootI] > maxComponentSize) {
                    maxComponentSize = size[rootI];
                }
            } else {
                parent[rootI] = rootJ;
                size[rootJ] += size[rootI];
                noOfComponents--;
                if(size[rootJ] > maxComponentSize) {
                    maxComponentSize = size[rootJ];
                }
            }
        }
    }
    public static void solve(FastScanner fs, PrintWriter out) {
        int n = fs.nextInt();
        int m = fs.nextInt();
 
        DSU dsu = new DSU(n);
        StringBuilder sb = new StringBuilder();
 
        for(int j = 0; j < m; j++) {
            int u = fs.nextInt() - 1;
            int v = fs.nextInt() - 1;
            dsu.union(u, v);
 
            sb.append(dsu.noOfComponents).append(" ").append(dsu.maxComponentSize).append("\n");
        }
        out.println(sb.toString());
        return;
    }
 
    public static void main(String[] args) {
        FastScanner fs = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);
        int t = 1;
        while (t-- > 0) {
            solve(fs, out);
        }
 
        out.flush();
        out.close();
    }
 
    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;
 
        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0)
                    return -1;
            }
            return buffer[ptr++];
        }
 
        String next() {
            StringBuilder sb = new StringBuilder();
            try {
                int c;
 
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return null;
                }
 
                do {
                    sb.append((char) c);
                    c = read();
                } while (c > ' ');
 
            } catch (IOException e) {
                return null;
            }
 
            return sb.toString();
        }
 
        int nextInt() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }
 
                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }
 
                int val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }
 
                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }
 
        long nextLong() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }
 
                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }
 
                long val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }
 
                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }
 
        double nextDouble() {
            return Double.parseDouble(next());
        }
 
        char nextChar() {
            return next().charAt(0);
        }
 
        String nextLine() {
            StringBuilder sb = new StringBuilder();
 
            try {
                int c = read();
 
                // skip '\n' and '\r'
                while (c == '\n' || c == '\r') {
                    c = read();
                }
 
                while (c != '\n' && c != '\r' && c != -1) {
                    sb.append((char) c);
                    c = read();
                }
 
            } catch (IOException e) {
                return null;
            }
 
            return sb.toString();
        }
    }
}
