import java.io.*;
import java.util.*;
 
 
public class Main {
    static List<List<Integer>> graph;
    static List<List<Integer>> revGraph;
    static boolean[] visited;
 
    private static void dfs(int node, List<List<Integer>> graph) {
        visited[node] = true;
        for (int ngh : graph.get(node)) {
            if (!visited[ngh]) {
                dfs(ngh, graph);
            }
        }
    }
    public static void solve(FastScanner fs, PrintWriter out) {
        int n = fs.nextInt();
        int m = fs.nextInt();
 
        graph = new ArrayList<>();
        revGraph = new ArrayList<>();
 
        for(int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
            revGraph.add(new ArrayList<>());
        }
 
        for(int i = 0; i < m; i++) {
            int u = fs.nextInt() - 1;
            int v = fs.nextInt() - 1;
            graph.get(u).add(v);
            revGraph.get(v).add(u);
        }
 
        visited = new boolean[n];
        dfs(0, graph);
        for(int i = 0; i < n; i++) {
            if(!visited[i]) {
                out.println("NO");
                out.println("1 " + (i + 1));
                return;
            }
        }
 
        visited = new boolean[n];
        dfs(0, revGraph);
        for(int i = 0; i < n; i++) {
            if(!visited[i]) {
                out.println("NO");
                out.println((i + 1) + " 1");
                return;
            }
        }
        out.println("YES");
        return;
    }
 
    public static void main(String[] args) {
        FastScanner fs = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);
        int t = 1;
        while (t-- > 0) {
            solve(fs, out);
        }
 
        out.flush();
        out.close();
    }
 
    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;
 
        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0)
                    return -1;
            }
            return buffer[ptr++];
        }
 
        String next() {
            StringBuilder sb = new StringBuilder();
            try {
                int c;
 
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return null;
                }
 
                do {
                    sb.append((char) c);
                    c = read();
                } while (c > ' ');
 
            } catch (IOException e) {
                return null;
            }
 
            return sb.toString();
        }
 
        int nextInt() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }
 
                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }
 
                int val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }
 
                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }
 
        long nextLong() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }
 
                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }
 
                long val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }
 
                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }
 
        double nextDouble() {
            return Double.parseDouble(next());
        }
 
        char nextChar() {
            return next().charAt(0);
        }
 
        String nextLine() {
            StringBuilder sb = new StringBuilder();
 
            try {
                int c = read();
 
                // skip '\n' and '\r'
                while (c == '\n' || c == '\r') {
                    c = read();
                }
 
                while (c != '\n' && c != '\r' && c != -1) {
                    sb.append((char) c);
                    c = read();
                }
 
            } catch (IOException e) {
                return null;
            }
 
            return sb.toString();
        }
    }
}
