import java.io.*;
import java.util.*;


public class Main {
    static class Edge {
        int v;
        long d;
        Edge(int v, long w) {
            this.v = v;
            this.d = w;
        }
    }
    static class State implements Comparable<State> {
        int node;
        long cost;
        State(int node, long cost) {
            this.node = node;
            this.cost = cost;
        }

        @Override
        public int compareTo(State o) {
            return Long.compare(this.cost, o.cost);
        }
    }
    static final long INF = (long) 1e17;

    public static void solve(FastScanner fs, PrintWriter out) {
        int n = fs.nextInt();
        int m = fs.nextInt();
        int k = fs.nextInt();

        List<List<Edge>> graph = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
        }
        for (int i = 0; i < m; i++) {
            int u = fs.nextInt()-1;
            int v = fs.nextInt()-1;
            long d = fs.nextLong();
            graph.get(u).add(new Edge(v,d));
        }

//        At each node, we will store k distances in maxheap
        PriorityQueue<Long>[] distance = new PriorityQueue[n];
        for (int i = 0; i < n; i++) {
            distance[i] = new PriorityQueue<>(Collections.reverseOrder());
        }
        distance[0].add(0L);

        PriorityQueue<State> pq = new PriorityQueue<>();
        pq.offer(new State(0, 0));

        while (!pq.isEmpty()) {
            State s = pq.poll();
            int u = s.node;
            long currD = s.cost;

//            optimazation: for if largest distance among k is still short than curr distance, no need to proceed
            if(currD > distance[u].peek()) continue;

            for(Edge ngh : graph.get(u)) {
                int v = ngh.v;
                long nextD = ngh.d + currD;

                if(distance[v].size() < k) {
                    distance[v].add(nextD);
                    pq.offer(new State(v,nextD));
                } else if(nextD < distance[v].peek()) {
                    distance[v].poll();
                    distance[v].add(nextD);
                    pq.offer(new State(v,nextD));
                }
            }
        }

        List<Long> ans = new ArrayList<>(distance[n-1]);
        Collections.sort(ans);

        StringBuilder sb = new StringBuilder();
        for(long d : ans) {
            sb.append(d).append(" ");
        }
        out.println(sb.toString().trim());
        return;
    }

    public static void main(String[] args) {
        FastScanner fs = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);
        int t = 1;
        while (t-- > 0) {
            solve(fs, out);
        }

        out.flush();
        out.close();
    }

    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0)
                    return -1;
            }
            return buffer[ptr++];
        }

        String next() {
            StringBuilder sb = new StringBuilder();
            try {
                int c;

                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return null;
                }

                do {
                    sb.append((char) c);
                    c = read();
                } while (c > ' ');

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }

        int nextInt() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                int val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        long nextLong() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                long val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        double nextDouble() {
            return Double.parseDouble(next());
        }

        char nextChar() {
            return next().charAt(0);
        }

        String nextLine() {
            StringBuilder sb = new StringBuilder();

            try {
                int c = read();

                // skip '\n' and '\r'
                while (c == '\n' || c == '\r') {
                    c = read();
                }

                while (c != '\n' && c != '\r' && c != -1) {
                    sb.append((char) c);
                    c = read();
                }

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }
    }
}
