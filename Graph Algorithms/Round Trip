import java.io.*;
import java.util.*;


public class Main {
    private static List<List<Integer>> graph;
    private static boolean[] visited;
    private static int parent[];
    private static int cycleStart = -1, cycleEnd = -1;


    private static boolean dfs(int cur, int p) {
        visited[cur] = true;
        parent[cur] = p;

        for (int next : graph.get(cur)) {
            if(next == p) continue;

            if (visited[next]) {
                cycleStart = next;
                cycleEnd = cur;
                return true;
            }

            if(dfs(next, cur)) {
                return true;
            }
        }
        return false;
    }

    public static void solve(FastScanner fs, PrintWriter out) {
        int n = fs.nextInt();
        int m = fs.nextInt();

        graph = new ArrayList<>();
        for(int i = 0; i < n; i++) {
            graph.add(new ArrayList<>());
        }

        for(int i = 0; i < m; i++) {
            int u = fs.nextInt()-1;
            int v = fs.nextInt()-1;
            graph.get(u).add(v);
            graph.get(v).add(u);
        }

        visited = new boolean[n];
        parent = new int[n];
        for(int i = 0; i < n; i++) {
            if(!visited[i]) {
                if (dfs(i, 0)) break;
            }
        }

        if (cycleStart == -1) {
            out.println("IMPOSSIBLE");
            return;
        }

        List<Integer> cycle = new ArrayList<>();
        cycle.add(cycleStart);

        for (int curr = cycleEnd; curr != cycleStart; curr = parent[curr]) {
            cycle.add(curr);
        }
        cycle.add(cycleStart);

        // Print cycle length and path
        out.println(cycle.size());
        StringBuilder ans = new StringBuilder();
        for (int node : cycle) {
            ans.append(node+1).append(" ");
        }
        out.println(ans.toString().trim());

        return;
    }

    public static void main(String[] args) {
        FastScanner fs = new FastScanner();
        PrintWriter out = new PrintWriter(System.out);
        int t = 1;
        while (t-- > 0) {
            solve(fs, out);
        }

        out.flush();
        out.close();
    }

    static class FastScanner {
        private final InputStream in = System.in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0)
                    return -1;
            }
            return buffer[ptr++];
        }

        String next() {
            StringBuilder sb = new StringBuilder();
            try {
                int c;

                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return null;
                }

                do {
                    sb.append((char) c);
                    c = read();
                } while (c > ' ');

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }

        int nextInt() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                int val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        long nextLong() {
            try {
                int c;
                while ((c = read()) <= ' ') {
                    if (c == -1)
                        return -1;
                }

                int sign = 1;
                if (c == '-') {
                    sign = -1;
                    c = read();
                }

                long val = 0;
                while (c > ' ') {
                    val = val * 10 + c - '0';
                    c = read();
                }

                return val * sign;
            } catch (IOException e) {
                return -1;
            }
        }

        double nextDouble() {
            return Double.parseDouble(next());
        }

        char nextChar() {
            return next().charAt(0);
        }

        String nextLine() {
            StringBuilder sb = new StringBuilder();

            try {
                int c = read();

                // skip '\n' and '\r'
                while (c == '\n' || c == '\r') {
                    c = read();
                }

                while (c != '\n' && c != '\r' && c != -1) {
                    sb.append((char) c);
                    c = read();
                }

            } catch (IOException e) {
                return null;
            }

            return sb.toString();
        }
    }
}
